SELECT
    p.CD_PRODUTO,
    p.DS_PRODUTO AS nome_produto,
    v.DT_VISUALIZACAO,
    LPAD(v.NR_HORA_VISUALIZACAO, 2, '0') || ':00' AS hora_visualizacao
FROM
    MC_SGV_VISUALIZACAO_VIDEO v
JOIN MC_PRODUTO p ON v.CD_PRODUTO = p.CD_PRODUTO
ORDER BY
    v.DT_VISUALIZACAO DESC,
    v.NR_HORA_VISUALIZACAO DESC;
